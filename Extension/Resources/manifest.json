{
  "manifest_version": 3,
  "name": "Soft Subs AirPlay",
  "version": "0.1.1",
  "description": "AirPlay web videos to your TV with their subtitles.",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png"
  },
  "action": {
    "default_title": "Send to TV with subtitles",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "toolbar-16.png",
      "19": "toolbar-19.png",
      "32": "toolbar-32.png",
      "38": "toolbar-38.png"
    }
  },
  "permissions": ["tabs", "cookies", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["subtitles.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    { "resources": ["page-hook.js"], "matches": ["<all_urls>"] }
  ]
}
